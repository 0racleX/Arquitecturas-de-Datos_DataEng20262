# Variables que necesita el pipeline en la EC2. NO llenes este archivo a mano:
# scripts/aws/render_env.sh genera /opt/de-dw/.env desde Secrets Manager (secreto <project>/connections),
# con los valores que crea Terraform. Este archivo solo documenta los nombres.

# Airflow (metadatos en PostgreSQL local a la EC2)
AIRFLOW_UID=1000
AIRFLOW_UI_PORT=8080
AIRFLOW_FERNET_KEY=<generado por terraform>
AIRFLOW_SECRET_KEY=<generado por terraform>
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=<generado por terraform>
POSTGRES_USER=airflow
POSTGRES_PASSWORD=<generado por terraform>

# Fuente relacional: Amazon RDS for MySQL
MYSQL_HOST=<id>.<hash>.us-east-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce
MYSQL_USER=etl_admin
MYSQL_PASSWORD=<generado por terraform>

# Fuente documental: Amazon DocumentDB (TLS obligatorio, retryWrites=false)
MONGODB_URI=mongodb://docdbadmin:<password>@<cluster>.docdb.amazonaws.com:27017/?tls=true&tlsCAFile=/opt/airflow/certs/global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGO_DATABASE=ecommerce

# Data warehouse: Amazon Redshift Serverless
REDSHIFT_HOST=<workgroup>.<account>.us-east-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=ecommerce_dw
REDSHIFT_USER=dwadmin
REDSHIFT_PASSWORD=<generado por terraform>
REDSHIFT_IAM_ROLE_ARN=arn:aws:iam::<account>:role/de-dw-redshift-s3-role

# Data lake y región
DE_DW_BUCKET=de-dw-lake-<account>-us-east-1
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
